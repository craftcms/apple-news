{
  "name": "craftcms/apple-news",
  "description": "Publish Craft CMS entries to Apple News",
  "type": "craft-plugin",
  "keywords": [
    "apple news",
    "cms",
    "craftcms",
    "laravel"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Pixel & Tonic",
      "homepage": "https://pixelandtonic.com/"
    }
  ],
  "support": {
    "email": "support@craftcms.com",
    "issues": "https://github.com/craftcms/apple-news/issues?state=open",
    "source": "https://github.com/craftcms/apple-news",
    "docs": "https://github.com/craftcms/apple-news/blob/5.x/README.md",
    "rss": "https://github.com/craftcms/apple-news/commits/5.x.atom"
  },
  "require": {
    "php": "^8.5",
    "craftcms/cms": "^6.0.0",
    "chapter-three/apple-news-api": "^0.3.9",
    "league/html-to-markdown": "^5.0"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "CraftCms\\AppleNews\\": "src/"
    }
  },
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G"
  },
  "extra": {
    "name": "Apple News",
    "handle": "apple-news",
    "description": "Publish entries to Apple News",
    "documentationUrl": "https://github.com/craftcms/apple-news/blob/5.x/README.md"
  },
  "config": {
    "platform": {
      "php": "8.5"
    },
    "allow-plugins": {
      "craftcms/plugin-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
